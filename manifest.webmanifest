{
  "name": "Espaço Giraosol",
  "short_name": "Espaço Giraosol",
  "description": "Agenda e gestão do Espaço Giraosol",
  "lang": "pt-BR",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FBF8F1",
  "theme_color": "#3F5626",
  "icons": [
    {
      "src": "icones/icone-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icones/icone-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icones/icone-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "files": [
        {
          "name": "arquivos",
          "accept": [
            "image/*",
            "application/pdf",
            ".pdf",
            ".jpg",
            ".jpeg",
            ".png"
          ]
        }
      ]
    }
  }
}
